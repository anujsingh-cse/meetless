{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "lint": {},
    "db:generate": {},
    "db:push": {},
    "db:migrate": {},
    "db:seed": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}